rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom Categories created by users
    match /custom_categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.words is list
                    && request.resource.data.expiresAt is number;
      // Two different kinds of "update" have to stay legal here:
      //  1. The creator editing their own category's content (name, words,
      //     icon, timer, ...) -- identified by their stable per-device
      //     Firebase Anonymous Auth uid, stamped as creatorUid at publish
      //     time, and an update can't reassign creatorUid to someone else.
      //     A doc published before this field existed has no creatorUid,
      //     so it can no longer be edited by anyone either (matches the
      //     app's own client-side check); a short-lived gap since these
      //     categories expire after 1 hour anyway.
      //  2. ANY player incrementing the play counter (recordCategoryPlay)
      //     when they play someone ELSE's category -- restricting update
      //     to the creator alone would silently break play-count tracking
      //     for everyone but the creator, so a write that only touches
      //     plays/updatedAt is allowed regardless of who's asking.
      allow update: if
        (request.auth != null
         && resource.data.creatorUid == request.auth.uid
         && request.resource.data.creatorUid == resource.data.creatorUid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays', 'updatedAt']);
      allow delete: if true;
    }

    // Global Real Player Leaderboard Entries
    match /global_leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.resource.data.playerName is string
                            && request.resource.data.score is number
                            && request.resource.data.score >= 0;
      allow delete: if false;
    }

    // Category Specific High Scores
    match /category_scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.resource.data.playerName is string
                            && request.resource.data.score is number
                            && request.resource.data.categoryId is number;
      allow delete: if false;
    }

    // Remote App Configuration (Ads, Feature Flags)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User Cloud Saves, Progress & IAP Purchases
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
