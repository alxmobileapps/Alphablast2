rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom Categories created by users
    match /custom_categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.words is list
                    && request.resource.data.expiresAt is number;
      // Updates are allowed as long as they don't change who OWNS the
      // category (creatorKeyHash / creatorUid can never be rewritten), so:
      //  - the creator can edit their own category's content, and
      //  - any player can bump the play counter (recordCategoryPlay).
      // Who may edit is enforced in the app: only the publishing device
      // sees the Edit button, and updateCustomCategory refuses otherwise
      // (see canEditCustomCategory). The previous rule required the
      // editor's Firebase Anonymous Auth uid to match, but the app can't
      // rely on anonymous sign-in being available -- when it isn't, that
      // rule rejected the creator's OWN edits. Rules can't verify the
      // per-device creator key without writing its secret into this
      // public document, so identity isn't re-checked here.
      allow update: if
        request.resource.data.get('creatorKeyHash', null) == resource.data.get('creatorKeyHash', null)
        && request.resource.data.get('creatorUid', null) == resource.data.get('creatorUid', null);
      allow delete: if true;
    }

    // Global Real Player Leaderboard Entries
    // Leaderboard entries used to be published under `sync_<BACKUP CODE>`,
    // exposing every player's secret backup code. Entries now use a random
    // public id (`p_...`). New/updated entries may never use a `sync_` id or
    // playerId, and the old `sync_` entries may be deleted (the app deletes
    // its own when it migrates; the rest are cleaned up once).
    match /global_leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.resource.data.playerName is string
                            && request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && !entryId.matches('sync_.*')
                            && !(request.resource.data.get('playerId', '') is string
                                 && request.resource.data.get('playerId', '').matches('sync_.*'));
      allow delete: if entryId.matches('sync_.*');
    }

    // Category Specific High Scores
    match /category_scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.resource.data.playerName is string
                            && request.resource.data.score is number
                            && request.resource.data.categoryId is number
                            && !scoreId.matches('sync_.*')
                            && !(request.resource.data.get('playerId', '') is string
                                 && request.resource.data.get('playerId', '').matches('sync_.*'));
      allow delete: if scoreId.matches('sync_.*');
    }

    // Remote App Configuration (Ads, Feature Flags)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User Cloud Saves, Progress & IAP Purchases
    // A cloud save's document id IS its backup code (`sync_<CODE>`), so
    // listing this collection handed out every player's code (and with it
    // their progress and purchases). Reading a single save by its exact id
    // (i.e. you already know the code) still works; listing/querying the
    // collection does not. Deleting saves is not something the app does.
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
